{
  "version": 1,
  "default": "deny",
  "purpose_bindings": {
    "customer_support": ["support_reply", "account_recovery"],
    "payments": ["fulfillment", "fraud_check"],
    "medical": ["care"],
    "marketing_optin": ["marketing", "support_reply"]
  },
  "redactions": [
    {
      "action_purpose": "support_reply",
      "redact_fields": ["ssn", "card_number"],
      "redact_patterns": [
        "\\b\\d{3}-\\d{2}-\\d{4}\\b",
        "\\b(?:\\d[ -]?){13,16}\\b"
      ]
    }
  ]
}
